<?xml version="1.0" encoding="utf-8"?>
<!--
    Этот файл говорит Android, какие папки можно «шарить» с камерой.
    Когда мы открываем камеру, нам нужно передать ей путь к файлу,
    куда она сохранит фото. FileProvider делает это безопасно.
-->
<paths>
    <!-- Папка внутри приложения — туда сохраняем фото -->
    <external-files-path
        name="my_images"
        path="Pictures/" />
    <files-path
        name="my_images_internal"
        path="Pictures/" />
</paths>
